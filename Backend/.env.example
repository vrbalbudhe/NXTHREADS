NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false

DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET_KEY=<at-least-32-random-characters>
# Encrypts authenticator-app (TOTP) secrets at rest. Falls back to JWT_SECRET_KEY.
# Set it explicitly so rotating the JWT secret doesn't break existing MFA setups.
MFA_ENCRYPTION_KEY=<at-least-32-random-characters>

# When SMTP_USER/SMTP_PASS are empty outside production, emails (OTP codes)
# are printed to the server console instead of being sent.

SMTP_SERVICE=Gmail
SMTP_USER=<sender-address>
SMTP_PASS=<app-password>
SMTP_FROM=<sender-address>

REDIS_URL=
SEED_PASSWORD=
